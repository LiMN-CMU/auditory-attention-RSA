{
    "mode": "auto",
    "subjects": [
        2
    ],
    "task": "craa",
    "base_dir": "/lab_data/barblab/Jinhee/auditory-attention-RSA/data",
    "raw_to_bids": {
        "input_folder": "sourcedata",
        "output_folder": "",
        "dataset_description": {
            "name": "Condition-Rich Auditory Attention Dataset",
            "authors": [
                "Winko An",
                "Abby Noyce",
                "Jinhee Kim"
            ]
        }
    },
    "filter": {
        "input_folder": "",
        "output_folder": "derivatives/filter",
        "reference_channels": [
            "EXG1",
            "EXG2"
        ],
        "frequency_low_cutoff": 0.5,
        "frequency_high_cutoff": 50.0,
        "target_sample_rate": 512,
        "filter_phase": "zero",
        "filter_window": "hamming"
    },
    "reject_channel": {
        "input_folder": "derivatives/filter",
        "output_folder": "derivatives/channelreject",
        "variance_threshold": 3,
        "amplitude_threshold": 0.0075
    },
    "calculate_ICA": {
        "input_folder": "derivatives/channelreject",
        "output_folder": "derivatives/ICAcalculate",
        "additional_frequency_low_cutoff": 1,
        "additional_frequency_high_cutoff": 30,
        "ICA_random_state": 2025,
        "ICA_max_iteration": 2048,
        "ICA_stop_tolerance": 1e-10,
        "ICA_method": "infomax"
    },
    "apply_ICA": {
        "input_folder": "derivatives/ICAcalculate",
        "output_folder": "derivatives/ICAreject",
        "iclabel_component_threshold": 15,
        "iclabel_proability_threshold": 0.9,
        "iclabel_bad_class": [
            "eye blink"
        ]
    },
    "epoch": {
        "input_folder": "derivatives/ICAreject",
        "output_folder": "derivatives/epoch",
        "epoch_boundary_cue": [
            -1.3,
            1
        ],
        "epoch_boundary_target": [
            -0.5,
            1
        ],
        "baseline_boundary": [
            -0.5,
            -0.2
        ]
    }
}
